{
  "name": "GreenAccess (Flutter Web + Firebase)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8080, 4000, 5001, 8085, 9099, 9199],
  "portsAttributes": {
    "8080": { "label": "App Flutter Web", "onAutoForward": "openPreview" },
    "4000": { "label": "Firebase Emulator UI", "onAutoForward": "silent" },
    "5001": { "label": "Cloud Functions (emulateur)", "onAutoForward": "silent" },
    "8085": { "label": "Firestore (emulateur)", "onAutoForward": "silent" },
    "9099": { "label": "Auth (emulateur)", "onAutoForward": "silent" },
    "9199": { "label": "Storage (emulateur)", "onAutoForward": "silent" }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/flutter/bin:/home/vscode/.pub-cache/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"]
    }
  }
}
