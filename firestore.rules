rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Lecture du rôle avec vérification d'existence pour éviter les erreurs
    // si le document utilisateur n'existe pas encore.
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'user';
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }

    function isPartenaireFinanceur() {
      return isAuth() && (getUserRole() == 'partenaireFinanceur' || isAdmin());
    }

    function isPartenaireAssureur() {
      return isAuth() && (getUserRole() == 'partenaireAssureur' || isAdmin());
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                    || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── User progress ────────────────────────────────────────────────────────
    match /users/{userId}/progress/{courseId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Badges ───────────────────────────────────────────────────────────────
    match /users/{userId}/badges/{badgeId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── Notifications personnelles ────────────────────────────────────────────
    match /users/{userId}/notifications/{notifId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Notifications globales ────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
    }

    // ── Courses ──────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      match /lecons/{leconId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }

      match /quiz/{quizId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }

      // Progression individuelle (collectionGroup 'progress')
      match /progress/{userId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ── Scores Climat ────────────────────────────────────────────────────────
    match /scores_climat/{scoreId} {
      allow read: if isAdmin()
                  || isPartenaireFinanceur()
                  || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Demandes de financement ───────────────────────────────────────────────
    match /demandes_financement/{demandeId} {
      allow read: if isAdmin()
                  || isPartenaireFinanceur()
                  || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
                    || isPartenaireFinanceur()
                    || (isOwner(resource.data.userId) && resource.data.statut == 'brouillon');
      allow delete: if isAdmin();

      // Sous-collection remboursements
      match /remboursements/{echeanceId} {
        allow read: if isAdmin()
                    || (isAuth() && get(/databases/$(database)/documents/demandes_financement/$(demandeId)).data.userId == request.auth.uid);
        allow write: if isAdmin()
                     || (isAuth() && get(/databases/$(database)/documents/demandes_financement/$(demandeId)).data.userId == request.auth.uid);
      }
    }

    // ── Paiements ─────────────────────────────────────────────────────────────
    match /paiements/{paiementId} {
      allow read: if isAdmin()
                  || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Produits assurance ────────────────────────────────────────────────────
    match /produits_assurance/{produitId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Contrats assurance ────────────────────────────────────────────────────
    match /contrats_assurance/{contratId} {
      // isAdmin() EN PREMIER (sans resource.data) pour permettre les
      // lectures de collection admin sans clause where.
      allow read: if isAdmin()
                  || isPartenaireAssureur()
                  || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isPartenaireAssureur();
      allow delete: if isAdmin();
    }

    // ── Sinistres ─────────────────────────────────────────────────────────────
    match /sinistres/{sinistreId} {
      allow read: if isAdmin()
                  || isPartenaireAssureur()
                  || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isPartenaireAssureur();
      allow delete: if isAdmin();
    }

    // ── Zones aléas ───────────────────────────────────────────────────────────
    match /zones_alea/{zoneId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Partenaires ───────────────────────────────────────────────────────────
    match /partenaires/{partenaireId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
